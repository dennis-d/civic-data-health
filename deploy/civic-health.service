[Unit]
Description=Civic Data Health MCP service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=civic-health
Group=civic-health
WorkingDirectory=/opt/civic-data-health
ExecStart=/opt/civic-data-health/.venv/bin/civic-health --db /var/lib/civic-data-health/civic_health.sqlite mcp --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/civic-data-health

[Install]
WantedBy=multi-user.target

